PYANNOTE_AUTH_TOKEN=your_huggingface_token_here
TRANSCRIPTION_BACKEND=faster-whisper
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=nl
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TARGET_CHUNK_SECONDS=600
CHUNK_OVERLAP_SECONDS=8
ENABLE_GLOBAL_NORMALIZATION=true

# Speakers: a number when you know it, or auto to let diarization decide.
# MIN_SPEAKERS / MAX_SPEAKERS only apply in auto mode. --speakers on the command line wins.
NUM_SPEAKERS=auto
#MIN_SPEAKERS=2
#MAX_SPEAKERS=4
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# Output toggles. Set ENABLE_DIARIZATION=false to transcribe only; pyannote is then
# never loaded and no PYANNOTE_AUTH_TOKEN is needed.
ENABLE_DIARIZATION=true
INCLUDE_TIMESTAMPS=true
INCLUDE_SPEAKER_LABELS=true
TRANSCRIPT_LINE_WIDTH=100
